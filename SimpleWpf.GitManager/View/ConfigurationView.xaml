<UserControl x:Class="SimpleWpf.GitManager.View.ConfigurationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa5="clr-namespace:FontAwesome5;assembly=FontAwesome5.Net">
    <Grid DataContext="{Binding TabDataContext}"
          ColumnDefinitions="Auto, *, Auto" 
          RowDefinitions="Auto, Auto, Auto, *" 
          HorizontalAlignment="Stretch">

        <TextBlock Style="{StaticResource LabelTextBlock}" Text="Directory" Margin="3" />
        <TextBlock Style="{StaticResource LabelTextBlock}" Grid.Row="1" Text="Git User (remote)" Margin="3" />
        <TextBlock Style="{StaticResource LabelTextBlock}" Grid.Row="2" Text="Git Password (remote)" Margin="3" />

        <TextBox Grid.Column="1" 
                 IsReadOnly="True"
                 Style="{StaticResource UserInputTextBox}" 
                 Text="{Binding Directory, UpdateSourceTrigger=PropertyChanged}" Margin="3" />

        <TextBox Grid.Column="1"
                    Grid.Row="1"
                    Style="{StaticResource UserInputTextBox}" 
                    Text="{Binding User, UpdateSourceTrigger=PropertyChanged}" Margin="3" />

        <PasswordBox x:Name="PasswordTB"
                        PasswordChanged="PasswordTB_PasswordChanged"
                        Grid.Column="1" 
                        Grid.Row="2"
                        Style="{StaticResource UserInputPasswordBox}" 
                        Margin="3" />

        <Button x:Name="OpenDirectoryButton" 
                Grid.Column="2" 
                Margin="3" 
                Width="24" 
                Height="24" 
                Style="{StaticResource UserControlButton}" 
                Click="OpenDirectoryButton_Click">
            <fa5:SvgAwesome Icon="Regular_FolderOpen" Style="{StaticResource FontAwesomeIconDefault}" />
        </Button>

        <GroupBox Grid.Row="3" 
                  Grid.ColumnSpan="3"
                  Foreground="DimGray" 
                  FontSize="14" Margin="5" 
                  BorderBrush="LightGray">
            <GroupBox.Header>
                <TextBlock Style="{StaticResource LabelTextBlock}">
                    <Run Text="Git Repos (" />
                    <Run Text="{Binding RepositoryCount, Mode=OneWay}" />
                    <Run Text=")" />
                </TextBlock>
            </GroupBox.Header>

            <Grid RowDefinitions="Auto, *, *">

                <Border Background="#11000000" BorderBrush="LightGray" BorderThickness="1" CornerRadius="5" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">



                    </StackPanel>
                </Border>

                <!-- Repositories (Up to date) -->
                <GroupBox Grid.Row="1" 
                          Foreground="DimGray" 
                          FontSize="14" Margin="5" 
                          BorderBrush="LightGray">
                    
                    <GroupBox.Header>
                        <TextBlock Style="{StaticResource LabelTextBlock}">
                            <Run Text="Up to Date (" />
                            <Run Text="{Binding RepositoriesUpToDate.Count, Mode=OneWay}" />
                            <Run Text=")" />
                        </TextBlock>
                    </GroupBox.Header>
                    <ScrollViewer Grid.Row="1" Padding="5" Margin="0 5 0 0" VerticalScrollBarVisibility="Auto">

                        <ListBox x:Name="RepoUpToDateLB"
                                 Template="{StaticResource ListBoxControlTemplate}"
                                 ItemsSource="{Binding RepositoriesUpToDate}"
                                 ItemTemplate="{StaticResource ListBoxRepositoryItemTemplate}"
                                 ItemContainerStyle="{StaticResource ListBoxItemContainerStyle}"
                                 MouseDoubleClick="RepoUpToDateLB_MouseDoubleClick"
                                 AlternationCount="2"
                                 SelectionMode="Extended"
                                 HorizontalAlignment="Stretch" 
                                 HorizontalContentAlignment="Stretch"
                                 BorderBrush="LightGray" 
                                 BorderThickness="1">
                        </ListBox>

                    </ScrollViewer>
                </GroupBox>

                <!-- Repositories (Behind) -->
                <GroupBox Grid.Row="2" 
                          Foreground="DimGray" 
                          FontSize="14" Margin="5" 
                          BorderBrush="LightGray">
                    
                    <GroupBox.Header>
                        <TextBlock Style="{StaticResource LabelTextBlock}">
                            <Run Text="Out of Date (" />
                            <Run Text="{Binding RepositoriesBehind.Count, Mode=OneWay}" />
                            <Run Text=")" />
                        </TextBlock>
                    </GroupBox.Header>
                    
                    <ScrollViewer Padding="5" Margin="0 5 0 0" VerticalScrollBarVisibility="Auto">

                        <ListBox x:Name="RepoBehindLB"
                                 Template="{StaticResource ListBoxControlTemplate}"
                                 ItemsSource="{Binding RepositoriesBehind}"
                                 ItemTemplate="{StaticResource ListBoxRepositoryItemTemplate}"
                                 ItemContainerStyle="{StaticResource ListBoxItemContainerStyle}"
                                 MouseDoubleClick="RepoBehindLB_MouseDoubleClick"
                                 AlternationCount="2"
                                 SelectionMode="Extended"
                                 HorizontalAlignment="Stretch" 
                                 HorizontalContentAlignment="Stretch"
                                 BorderBrush="LightGray" 
                                 BorderThickness="1">
                        </ListBox>

                    </ScrollViewer>
                </GroupBox>
            </Grid>
        </GroupBox>

    </Grid>
</UserControl>
